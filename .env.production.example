
APP_NAME=Restoran
APP_URL=http://example.com
APP_KEY=
APP_TIMEZONE=Asia/Ashgabat
APP_LOCALE=tk
APP_FALLBACK_LOCALE=ru
RESTAURANT_NAME="Restoran"

# Владелец, которого создаёт первый запуск db:seed
OWNER_LOGIN=owner
OWNER_PASSWORD=

# Те же значения — в docker/.env.data (POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD)
DB_DATABASE=restoran
DB_USERNAME=restoran
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# Ключи Reverb: придумайте свои (openssl rand -hex 16)
REVERB_APP_ID=restoran
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Папка для резервных копий, лучше на отдельном диске
BACKUP_HOST_DIR=/var/backups/restoran
