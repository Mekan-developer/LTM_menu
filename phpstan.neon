includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Модели объявляют касты методом casts() — Larastan должен разбирать его тело.
    parseModelCastsMethod: true
